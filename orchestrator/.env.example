ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE
# Model for all agent roles. Switch without rebuilding:
#   claude-haiku-4-5-20251001   — cheapest, for flow/integration testing
#   claude-sonnet-4-6           — default, for benchmarks
CODEPILOT_CLAUDE_MODEL=claude-sonnet-4-6

# Database password — used by both postgres and orchestrator containers.
# Change this to a strong random password for any non-throwaway environment.
DB_PASSWORD=CHANGE_ME
